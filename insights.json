      {
        "tag": "Sector data",
        "impact": "High",
        "title": "WA demand is flat while the nation grows",
        "body": "Applications grew 5.4% nationally in 2025 but fell 0.2% in WA. Growth for a WA university has to come from winning share, so campaign targeting and conversion matter more than reach."
      },
      {
        "tag": "Sector data",
        "impact": "High",
        "title": "Target career changers for Education",
        "body": "Education had the fastest application growth (+12.0%), and 76.5% of its offers went to applicants without an ATAR or not in Year 12. Mature-age audiences deserve their own creative and channels."
      },
      {
        "tag": "Sector data",
        "impact": "Medium",
        "title": "WA Nursing is outperforming",
        "body": "WA Nursing applications rose 5.5% in 2025 against 2.3% nationally, yet only 66.3% of WA applicants received an offer (75.6% nationally). Demand exceeds places: focus spend on conversion and on pathway courses for applicants who miss out."
      },
      {
        "tag": "Sector data",
        "impact": "Medium",
        "title": "WA Teaching is lagging the national surge",
        "body": "Teaching applications jumped 12.3% nationally but only 1.0% in WA. There is untapped demand to unlock with targeted campaigns."
      },
      {
        "tag": "Sector data",
        "impact": "Medium",
        "title": "Plan budgets around the job market",
        "body": "Since 1989, changes in applications move with the prior year's change in unemployment (correlation r = 0.6). Use labour market forecasts when setting next year's acquisition targets."
      }
